00:00:06,156 --> 00:00:09,784
ད་ལྟ་བར་དོ་ཟིན། གདམ་ངག་གཅིག་ལས་སླ་བོ་སླ་བོ་འདྲ་བོ་བཤད་ཀྱི་ཡོད་རེད།

2
00:00:10,341 --> 00:00:11,775
དེ་ག་རེ་རེད་ཟེར་ན།

3
00:00:12,096 --> 00:00:18,955
ད་ལྟའི་ལུས་འདི་ཡོད་རེད། ད་ལྟའི་ལུས་འདི་ལས་ཀྱི་གྲུབ་ཚར་དུས། ལས་དེ་མ་རྫོགས་ཀྱི་བར་དུ་སྣུམ་གྱི་མར་མེ། རྒྱུ་རྐྱེན་

4
00:00:18,955 --> 00:00:25,815
ལུས་དེ། ཨོ་ད་ལྟ་དེ་དངོས་གནས་རེད། དེ་ད་དངོས་གནས་ཡིན་པ་འདྲ་བོ་རེད་དེ། སང་ཉིན་ཤི་ཚར་དུས་དེ་ཁོ་ཡོད་མ་རེད། གཅིག་པ་གཅིག་ཀྱང་།

5
00:00:26,254 --> 00:00:27,452
ཡ་འདི།

6
00:00:28,684 --> 00:00:33,687
ད་ལྟ། བར་དོ་དེའི་ཚུར་སྣང་དེའི་ལས་སྣང་གི་བག་ཆགས་དེ་མ་རྫོགས་ཀྱི་བར་དུ། བར་དོ་ལ་དངོས་གནས་ཡོད་རེད། སྡུག་བསྔལ་དངོས་གནས་

7
00:00:33,687 --> 00:00:38,691
དེ་མྱོང་ཡོང་གི་ཡོད་རེད། ད་ལྟ་སྡུག ད་ལྟ་ཁ་ཚ་མྱོང་བའི། ལས་སྣང་དེ་རྫོགས་ཚར་ནས། ཡང་ཡོད་མ་རེད།

8
00:00:39,602 --> 00:00:41,796
འདི་ལྟ་བུ་དེ་ལ་ང་ཚོའི་བར་དོ་ད་ལྟའི་ལུས་དེ་རེད་བ།

9
00:00:41,965 --> 00:00:48,816
འདི་ཁོ་རྨི་ལམ་སྐབས་ནས་ཡོད་ས་མ་རེད་བ། རྨི་ལམ་སྐབས་མེད་པ་ནང་བཞིན་ཆགས་བསྡད་རེད། རྨི་ལམ་སྐབས་ནས་ཁ་ཤས་ནམ་མཁའ་ལ་འཕུར། འདྲ་མི་འདྲ་བྱེད་ཐུབ་ཀྱི་ཡོད་རེད།

10
00:00:49,424 --> 00:00:55,499
རང་གཟུགས་དང་རྨི་ལམ་ལས། དེ་ནས་དེ་དུས་དེ་མི་ལ་རས་པས་རྨི་ལམ་དང་ཉིན་པར་གཉིས་གཅིག་པ་གཅིག་རྐྱང་རེད་ཟེར།

11
00:00:57,338 --> 00:00:58,570
སང་ཉིན་ཤི་བསྡད་ཁྱོད་

12
00:00:58,907 --> 00:01:01,084
མི་ཡུལ་ལ་ལོ་བརྒྱ་བསྡད་ལས་སྣང་བ་ཡོད་ན་ཡང་།

13
00:01:01,692 --> 00:01:05,472
དག་སྣང་བར་དོ་ནས། དང་བར་དོ་ནས་ཚུར་མི་ཡུལ་ལས།

14
00:01:06,788 --> 00:01:16,788
མི་ལམ། མི་ཡུལ་གྱི་གཉིད་ལམ་དེ་ད་སད་སོང་། གཉིད་སད་འོང་སང་ཉིན། ནམ་ལངས་དུས་ཞག་གཅིག་གི་རྨི་ལམ་ལྟ་བུ་མི་ཡུལ་ལ་ཆགས་ཚར་རེད། ཡོད་མ་རེད། སྣང་བ་དེ་གཅིག་ཀྱང་མེད་པ་ཆགས་བསྡད་ཡོད་རེད། དེ་ལས་རྒྱུ་

15
00:01:16,788 --> 00:01:26,788
ཡིན་པའི་བག་ཆགས་དེ་རྫོགས་འགྲོ་གི་ཡོད་རེད། དེ་ལྟ་བུ། དེ་ལྟ་བུ་ཧ་གོ་རེད། ཨོ། ད་བར་དོ་དང་ཚེ་འདི་དང་ཕྱི་མ་བར་དོ་གསུམ་གཅིག་རེད་གསུངས། དེ་འཇིག་རྟེན་གསུམ་མགོན་གྱི་གསུངས་ན། ད་ལྟ་གཅིག་རེད་བསམས་

16
00:01:26,788 --> 00:01:32,016
ལྟ་བུ་གཅིག་རེད་བསམས་ནས་བདེ་བ་ཐོབ་ན། ཚེ་འདི་ལ་ཆགས་ཞེན་ཆུང་གི་རེད། ཨེ་དེ་ནས་དེ་ལ།

17
00:01:32,235 --> 00:01:37,247
དེ་རེས་ད་ལྟ་ཆགས་ཞེན་བྱུང་བ་ན། ད་རིང་འོག་ནས་གསུང་ཡོད་རེད། འོ། ད་ལྟ་

18
00:01:37,939 --> 00:01:46,900
ཨེ། ཡུན་རིང་འགྲོགས་པའི་མཛའ་བཤེས་སོ་སོར་འབྲལ་གསུངས། མི་རྟག་པའི་སྒོ་ནས་བསྒོམ་རྒྱུ་དེ། མཆོག་ཡིན་ད་རེས་འགོ་ནས་དེ་བཤད་ཡོད་རེད། མི་རྟག་པ་ཟེར། འདི་སྟོང་པ་ཉིད་དེ།

19
00:01:47,170 --> 00:01:55,455
དེ་ནས་ད་ལྟ་སྒྱུ་མ་ལྟ་བུ་རེད། ཚེ་འདི་རྨི་ལམ་ལྟ་བུ་རེད་བསམས། རྨི་ལམ་རྨིས་པ་དེ་ཁྱད་མེད་ཡང་དང་ཡང་དུ་དྲན་ན། དེ་རེས་དངོས་གནས་ཁྱད་མེད་པ་ཆགས་བསྡད་ཡོད་རེད་ལྟ་ཤེས་ན།

