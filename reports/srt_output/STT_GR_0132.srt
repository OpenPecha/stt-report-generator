བཅུག་ནས་བསྡད་དེ་ཡར་བཞག་དུས་དེ་ནས་རྦ་རླབས་རྒྱ་མཚོའི་ཆོ་འཕྲུལ་ཡིན་གསུངས་པ་རེད། དེ་ནས་ད་ལྟ་སེམས་་ཉམས་སུ་ལེན་པའི་སྐབས་ནས་སྒོམ་རྒྱག་དུས། ཨེ། དེ་ནས་དང་པོ་གནས་ཐུབ་ཀྱི་ཡོད་མ་རེད། ད་གཙོ་བོ་དེ་མདོ།

213
01:05:03,204 --> 01:05:06,829
ཚོགས་ནི་ཞི་གནས་དང་ལྷག་མཐོང་གསུངས་རེད། ད་ཞི་གནས་དེ། ཨེ།

214
01:05:14,744 --> 01:05:18,878
རྩེ་གཅིག་དང་། རྩེ་གཅིག་དང་སྤྲོས་བྲལ་དེ་ཞི་གནས་ཀྱི་ཨེ། ཨེ།

215
01:05:19,637 --> 01:05:28,345
འདྲ་བོ་དེ་ནས་རོ་གཅིག་དེ་སྒོམ་ནས་དེ་ནས་ལྷག་མཐོང་གི་ཆ་དེ་འདྲ་བོ་རེ་ཕལ་ཆེར་ཆགས་བསྡད་རེད་ཉམས་མྱོང་ད་དེ་ཨེ་དེ་བས་ན་དེ་ནས།

216
01:05:28,716 --> 01:05:35,095
རྟོག་པའི་རླུང་གིས་མི་ཆོད་པ་གསུངས་པ་དེ་ལ། སྒོམ་རྒྱག་པའི་སྐབས་ནས་རྣམ་རྟོག་གང་སྐྱེས་ན་དེ་ནས་རྣམ་རྟོག་དེའི་དབང་དུ་མ་ཤོར་བ།

217
01:05:35,365 --> 01:05:43,110
ཨེ། དེ་ནས་རྣམ་རྟོག་རང་ས་ལ་ཞིག་ཐུབ་པ། དེ་ནས་རང་དབང་འདྲ་བོ་ཐོབ་ཡོད་པ་དེ་རེད། རྟོག་པའི་རླུང་གིས་མི་ཆོད་པ་ཟེར། རྒྱུན་རིང་པོ་གནས་ཐུབ་པ།

218
01:05:43,650 --> 01:05:45,591
གནས་ཆ་དེ་ལ་གསལ་ཆ་ཡོད་ཟེར།

219
01:05:46,266 --> 01:05:52,712
དཔེ་རྒྱ་མཚོ་ལ་བལྟས་ན་བྱིང་རྒོད་མེད་པ་ཡོན་ཏན་གནས་ཟེར། བྱིང་བ་ཟེར་ན་དེ་ནས་ཉོབ་ཏོ་འདྲ་དཔེར་ན་སེམས་གསལ་བོ་མེད་པ།

220
01:05:53,269 --> 01:05:59,192
ཨེ་དེ་ནས་རྣམ་རྟོག་འདི་ཡིན་ངོས་བཟུང་ཡང་མེད་པ་བྱས། སྒོམ་རྒྱག་འདོད་ཡང་མེད་པ། སེམས་གསལ་བོ་མེད་པ།  དེ་རེད།

221
01:05:59,209 --> 01:06:04,533
ཨེ་དེ་ནས་རྒོད་ཟེར་ན་དེ་ནས་ཉོན་མོངས་པ་རྣམ་རྟོག་ཤུགས་ཆེན་པོ། དེའི་དབང་དུ་ཤོར་འགྲོ།

222
01:06:04,533 --> 01:06:09,857
ཨེ་དེ་ནས་རྒོད་པ་རྒོད་པའི་སྐྱོན་དེ་དེ་ལས་བྲལ་ཐུབ་ན་བྱིང་རྒོད་རེད། ལོ་རྒྱུས་མང་པོ་བཤད་ཀྱི་ཡོད་རེད།

223
01:06:10,229 --> 01:06:13,384
ཨོ། བྱིང་རྒོད་མེད་པ་ཡོན་ཏན་གནས་གསུངས།

224
01:06:13,823 --> 01:06:21,231
ཨོ་དེ་ལྟ་བྱིང་རྒོད་མེད་པར། དེ་ནས་ཡུན་རིང་པོ་དེ་ནས་ཡུན་རིང་ཇི་ཙམ་བརྩམས་ལ་བསྡད་ཐུབ་ན། དེ་ནས་དེ་ད་རྩེ་གཅིག རྩེ་གཅིག་དེ་རེད་ཟེར།

225
01:06:21,940 --> 01:06:30,040
མདོར་ན་དེ་གནས་ཞེས་པ་དེ། ཨེ། ད་སེམས་རྣམ་རྟོག་ག་ཚད་འཚུབ་ན་ཡང་། དེ་ནས་ཤེས་མཁན་གྱི་རིག་པ་གཅིག་པོ་དེ་བལྟས་ནས།

226
01:06:30,782 --> 01:06:39,591
དེ་ནས་རྟེན་མི་གཡོ་བར་བསྡད་ཡོང་ན། དེ་ནས་རྣམ་རྟོག་ཤར་ན་མི་ཡོང་བ་ཤར་མ་ཤར་མེད་པ་དེ་འདྲ་བོ་ཆགས་ཡོང་གི་རེད། གནས་ཞེས་པ་དེ་རེད། ཤེས་པ་གསལ་བོ་དེ་གནས་ཡོང་གི་ཡོད་རེད།

227
01:06:40,165 --> 01:06:47,033
ཨེ་སེམས་རྣམ་རྟོག་མེད་པའི་སེམས་དེ་གཅིག་དགོས་བསམས་ནས་དེ་ཁག་པོ་ཡོད། དེ་གནས་ན་དེ་ནས་རྣམ་རྟོག་ལ་གནོད་པ་ཡང་མེད་པ། དེ་འདྲ་བོ་ཤར་ཡོང་གི་ཡོད་རེད།

228
01:06:48,299 --> 01:06:52,112
དེ་ནས་དེ་ལ། ཨེ་བྱིང་རྒོད་མེད་པ། རྩེ་གཅིག་གི་རྣལ་འབྱོར་ཡིན་པ་ལ་ལྟ་གསུངས།

229
01:06:52,619 --> 01:06:56,719
མདོར་ན་སེམས་གསལ་བོ་དེ་རང་གིས་སྒོམ་བརྒྱབ་ནས་ག་ཚོད་བསྡད་ན།

230
01:06:57,158 --> 01:06:58,187
ཨེ། གནས་ཐུབ་པ།

231
01:07:00,533 --> 01:07:03,064
དེའི་ངང་ལ་མ་གཡེངས་པར་གནས་ཐུབ་པ། དེ་རྩེ་གཅིག་རེད་གསུངས།

232
01:07:03,975 --> 01:07:05,612
རྩེ་གཅིག་གི་རྣལ་འབྱོར་ཡིན་པར་གདའ་གསུངས།

233
01:11:38,279 --> 01:11:42,582
ཨེ། སེམས་ཀྱི་སེམས་ལ་བལྟས་བྱས་ན། བལྟ་བྱ་ལྟ་བྱེད་གཉིས་དང་བྲལ།

234
01:11:43,206 --> 01:11:47,324
དཔེ་སྔར་འདྲིས་ཀྱི་མི་དང་འཕྲད་པ་བཞིན། སེམས་ཉིད་རང་ངོ་རང་གིས་ཤེས།

235
01:11:47,745 --> 01:11:50,445
ཨེ་དེ་སྤྲོས་བྲལ་གྱི་སྐྱེ་ཚུལ་ཡིན་པར་གདའ་གསུངས།

236
01:11:51,171 --> 01:12:00,958
ཨེ། སེམས་ལ་ལྟ་མཁན་གྱི་ཤེས་པ་དེ་ལ་ད་རྣམ་རྟོག་ཐམས་ཅད་དང་བྲལ་བའི་སྐབས་སུ་བལྟས་ན་དེ་ནས་བལྟ་བྱ་་ལྟ་བྱེད་ཁ་ཁ་མ་ཡིན་པ། བལྟ་བྱ་ལྟ་བྱེད་གཅིག་ཏུ་འདྲེས་འགྲོ་གི་ཡོད་རེད།

237
01:12:00,958 --> 01:12:10,746
ཡོད་མ་རེད། ཤེས་ཞེས་པ་ད་དེ་ལ་གསལ་སྟོང་ལབ་ཀྱི་ཡོད་རེད། གསལ་ཟེར་ན་སེམས་ཀྱིས་རྣམ་རྟོག་ཡོད་མེད་གསལ་བོ་ཤེས་ཀྱི་ཡོད་ཟེར། སྟོང་དེས་གང་ཡང་མེད་པ་དེ་ནས།

238
01:12:10,965 --> 01:12:17,547
ད་དེ་ལ་དེ་ནས་ད་ལ། གསལ་སྟོང་ཟུང་འཇུག་ཟེར། ཨེ་དེ་གསུང་གི་ཡོད་རེད། རང་རང་གིས་ཤེས་གསུངས་ནས།

239
01:12:20,061 --> 01:12:22,052
གསལ་བའི་རང་བཞིན་དེ་ལ་སྟོང་པའི་རང་བཞིན་ཤེས་པ།

240
01:12:23,419 --> 01:12:24,465
ད་སྨྲ་བསམ་བརྗོད་མེད།

241
01:12:24,972 --> 01:12:28,600
དེ་ལ་སོགས་པ་ཐམས་ཅད་སྟོང་པའི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་སྐོར་ལ་བསམ་བློ་བཏང་ན་ད་ལྟ།

242
01:12:28,988 --> 01:12:30,979
གཅིག་ཀྱང་མེད་པའི་ནམ་མཁའ་སྟོང་པ་གནས་ཟེར།

243
01:12:31,688 --> 01:12:35,147
ས་བཅད་ནང་ནས། ཅི་ཡང་མ་སེམས་ལམ་དེ་ཆོས་ལ་འདུས་གསུངས།

244
01:12:35,249 --> 01:12:39,518
རྣམ་རྟོག་གང་ལམ་མེད་པའི་སེམས་དེ་གསལ་བོ་ཧ་གོ་བ་ད། དེ་ག་རང་རེད།

245
01:12:40,800 --> 01:12:43,703
དེ་ནས་དེ་སྤྲོས་བྲལ་དེ་སྐྱེས་ཚུལ་ཡིན་པར་གདའ་གསུངས།

246
01:14:39,145 --> 01:14:43,735
ཨེ། སྨྲ་བསམ་བརྗོད་མེད་ཟེར། རྟོག་དཔྱོད་ཀྱི་ཡུལ་ལས་བརྒལ་བ་དེ་ལ་དེ་ནས་སྤྲོས་བྲལ་ཟེར།

247
01:14:44,444 --> 01:14:45,844
ཨེ། ངག་ནས་སྨྲ་མི་ཐུབ་པ།

248
01:14:45,962 --> 01:14:47,464
རང་སེམས་ཀྱིས་ཧ་གོ་ལེ་མེད་འདུག

249
01:14:47,768 --> 01:14:50,316
ཡོད་མེད་གཅིག་ཀྱང་མིག་གིས་མཐོང་མི་ཐུབ་པ་དེ་ལ་སྤྲོད་བྲལ་ཟེར།

250
01:15:25,332 --> 01:15:29,264
དེ་ལ་གོང་ཕུད་བྱས་རྩ་ན་སྣང་སྲིད་འཁོར་འདས་ཐམས་ཅད་ཀུན།

251
01:15:29,854 --> 01:15:35,777
སྣང་སྲིད་འཁོར་འདས་མ་ལུས་པ་ཐམས་ཅད་རང་གི་སེམས་སུ་ཤེས་ཟེར། ད་ཉིད་གདོད་ནས་དག་པར་གདའ་གསུངས།

252
01:15:36,520 --> 01:15:39,777
