རྣམ་རྟོག་མེད་ན་ཨེ་རེད་ད་ལྟ། ངས་ད་ལྟ་སྔོན་མ་ལབ་ལ་དོན་རང་དེ་རེད། རྣམ་རྟོག་ཉོན་མོངས་གང་འཆར་ན་དེ་རེད་ཁོ། ཕྱི་གཟུགས་སྒྲ་ལ་སོགས་པ་ལ་འཛིན་པ་མེད་པ། དེ་ལ་སྣང་སྟོང་གྱི་རེད། ཨོ།

53
00:09:16,200 --> 00:09:25,000
དཔེར་ན། མི་ཁང་པ་གང་དེའི་ནང་བསྡད་ཡོད་ན་ཡང་། དེ་ཐམས་ཅད། ཨོ་མི་དེ་གཅིག་ཀྱང་མི་འདུག་བསམ་རྒྱུ་ཡོད་མ་རེད། མི་དེ་ཡོད་ན་གནོད་པ་མེད་པ། མེ་ལོང་ནང་གི་གཟུགས་བརྙན་ལྟ་བུའི་དེ་ལ།  

54
00:09:26,800 --> 00:09:30,800
དངོས་པོ་དང་བདེན་འཛིན་མེད་ལ་དེ་ཡོང་གི་རེད་བ། དེ་ལ་སྣང་སྟོང་རྫས།  

55
00:09:32,500 --> 00:09:35,900
ནང་སེམས་སྣང་སྟོང་ཆགས་ན་དེ་ནས།  

56
00:09:36,300 --> 00:09:41,900
སངས་རྒྱས་སེམས་ཅན་གཉིས་ཡིན་ལ། ཨ། འཁོར་འདས་གཅིག་ཏུ་ཉམས་སུ་མྱོང་།

57
00:09:42,500 --> 00:09:46,700
དེ་ཁོང་གིས་སྔོན་མ་གསུང་གིས་ལབ་རེད་རེད་བ། ཨེ།  

58
00:09:47,100 --> 00:09:51,500
རྣམ་ཤེས་མ་མཐོང་ཡེ་ཤེས་མཐོང་ན། སེམས་ཅན་མ་མཐོང་སངས་རྒྱས་མཐོང་གསུངས།  

59
00:09:51,800 --> 00:09:58,500
ད་དོད་དེ་རེད། རང་གི་སེམས་ཀི་གནས་ལུགས་མཐོང་ན། དེ་མཐོང་གི་རེད། རྣམ་ཤེས་སེ་ཤེས་མཐོང་ཡ་འདི་གལ་ཆེན་པོ་རེད།  

60
00:09:58,900 --> 00:10:03,900
རྣམ་ཤེས་མ་མཐོང་ཡེ་ཤེས་མཐོང་། རྣམ་ཤེས་ད་ལྟ་འུ་ཚོ་ཐར་པར་ཕྱིན་པ་གཉིས་མ་གཏོགས་ད་འུ་ཚོ་ཚང་མ་ཡོད་རེད།

61
00:10:04,900 --> 00:10:14,800
རྟོག་དཔྱོད་འུ་ཚོ་ཇ་ཕོར་རུ་གང་འཐུང་ཡོད་ན། རྣམ་ཤེས་མཐོང་གི་ཡོད་རེད་བ། འདི་ནི་འཐུང་བྱ་རེད། འདི་འཐུང་རེད། དེ་འཐུང་ཡ་རེད་ཟེར་ཧ་གོ་གི་ཡོད་རེད། ཨོ་འདི་སེམས་ཅན་གི་ཤེས་པ་དེ་

62
00:10:16,300 --> 00:10:41,100
ཤེས་པ་ཡུལ་ལ་རྟོག་དཔྱོད་ཡུལ་དེ་རེད་རྟོག་དཔྱོད་མ་གཏོགས། སེམས་ཅན་ཤེས་པ་ཁོ་རང་ཨ། ངའི་ངོས་གནས་གནམ་ཤེས་དེ་ག་རེ་རེད། གནམ་ཤེས་ཁོ་རང་ངོ་ལ་ཚུར་བལྟས་ཚར་ན། ཕར་ཡུལ་ལ་མ་གཏོགས་ལ་ཚུར་ཁ་ནང་ལ་བསྐོར་ལ་བལྟས་ན། དེ་ནས་གནམ་ཤེས་ཁོ་རང་ནམ་མཁའ་ལྟ་བུ་ཆགས་འགྲོ་གི་ཡོད་རེད། གཉིས་མེད་ལ། ལྟ་དང་ལྟ་མཁན་གཉིས་མེད་ལ། རང་བཞིན་གིས་སྟོང་སང་ངེར་ཚུར་འགྲོ་གི་རེད། དེའི་སྐབས་སུ་དེ་ནས་ཡེ་ཤེས་དེ། ཡེ་ཤེས་ག་རེ་བྱེད་ཀི་རེད། ཡེ་ནས་ཡོད་པའི་ཡེ་ཤེས་བྱ། ཐམས་ཅད་ཤེས་པའི་ཤེས་ཤིང་བྱ་རྫས་རེད།  

63
00:10:44,400 --> 00:10:52,200
དེ་འཁོར་བ་ཐོག་མ་མེད་ནས་ཡེ་ནས་རྫས་རེད། འཁོར་བ་ཐོག་མ་མེད་པ་ནས་ཡོད་རེད། མ་འོངས་པ་ལ་ཡོད་རེད། ད་ལྟ་ཡོད་རེད། ཁོ་འགྱུར་བ་རྩ་བ་ནས་མེད་པ།  

64
00:10:53,000 --> 00:11:06,100
སེམས་སྟོང་པ་ནམ་མཁའ་ལྟ་བུ་དེ། སེམས་གཙང་པ་གཙང་རྐྱང་དེ་དུས་སྐད་ཅིག་གི་ད་མར་ཤེས་པ་གཅིག་ཡིན་པ། དེ་དུས་མཐོང་གི་ཡོད་རེད་བ། རྣམ་ཤེས་ཡེ་ཤེས་ལས་འགྱུར་རྫས་ན། ད་ལྟ་ཤེས་མཁན་ཤེས་པ་དེ་ལ་བརྟག་དཔྱད་བཏང་ན། ལམ་སང་བརྟེན་ནས་འདིའི་ངོ་ལ་དེ་བརྟག་ས་རག་གི་མ་རེད་བ།

65
00:11:06,600 --> 00:11:11,400
སྟོང་མཐོང་ཞིག་འགྲོ་གི་རེད། ད་དེ་དུས་མཐོང་གི་ཡོད་རེད། ད་མལ་པ་ཚོས་མཐོང་ངོ་བསམ་གྱི་ཡོད་རེད།  

66
00:11:14,900 --> 00:11:18,300
བདག་མེད་བལྟས་པས་ཐོགས་མེད་མཐོང་ཆོག་རྫས།  

67
00:11:21,000 --> 00:11:33,900
ལྟ་ས་མེད་ས་ག་རེ་རེད། རང་གི་སེམས་ལ། རང་གི་སེམས་ལ་ཚུར་གཅིག་བལྟས་ན། མཐོང་རྒྱུ་མེད་པ་དེ་མཐོང་རེད། མཐོང་རྒྱུ་མེད་པ་གང་རེད། ནམ་མཁའ་ལྟ་བུ་གེ་མཐོང་མ་སོང་། ཡང་མཐོང་མཁན་ཤེས་པ་གསལ་བོ་གཅིག་ཡོད་རེད། དཔེ་དེ་རེད།  

68
00:11:37,800 --> 00:11:41,500
ཨེ་ནས་མཐོང་མཁན་གསལ་བོ་གཅིག་ཡོད་རེད། གོམས་ཐེབ་འགྲོ་གི་མ་རེད།  

