1
00:00:01,383 --> 00:00:08,293
དེ་ནས་ད་སེམས་ཀྱི་གནས་ལུགས་མཐོང་། སྐབས་རེ་ད་གསུང་གི་ཡོད་རེད། དཔེར་ན་ནམ་མཁའ་ཇི་ལྟར་བརྟག་དང་དབུས་སུ་འཛིན་པ་དགག་པར་འགྱུར་ཟེར།

2
00:00:08,938 --> 00:00:14,168
དེ་ཡི་སེམས་ཀྱི་ཟིན་པའི་བརྟགས་བྱས་ན། རྣམ་རྟོག་ཚོགས་འགག་སེམས་ཀྱི་རང་བཞིན་མཐོང་གསུངས།

3
00:00:15,271 --> 00:00:18,853
དཔེར་ན་ད་ལྟ་ང་ཚོས་ནམ་མཁའ་བརྟག་དཔྱད་གཏོང་གི་ཡོད་མ་རེད། བརྟག་དཔྱད་བཏང་ན་ད།

4
00:00:18,972 --> 00:00:25,831
ད་ནམ་མཁའ་དེ་བལྟས་བསྡད་ནས། ནམ་མཁའ་མཐའ་ག་རེ་རེད། དབུས་ག་རེ་རེད་གཅིག་གིས་དྲི་བ་བཏང་ན། དེ་ནས་བསམ་བློ་བཏང་ན་ཡ་སུས་ཀྱང་ལབ་ཐུབ་ཀྱི་མ་རེད།

5
00:00:26,477 --> 00:00:29,448
སོ་སོས་མཐོང་བ་དེ་དབུས་རེད་བརྫས་ན་འགྲིག་གི་ཡོད་མ་རེད།

6
00:00:30,365 --> 00:00:32,436
མཐར་ག་བ་རེད་ཟེར་ན། སུ་གཅིག་ལ་ལབ་ཡ་ཡོད་མ་རེད།

7
00:00:33,098 --> 00:00:35,747
ཨོ་དེ་ནང་བཞིན་སེམས་ཀྱི་གནས་ལུགས་ཚུར་མཐོང་བ་དེ་ལ་དེ་ནས།

8
00:00:36,426 --> 00:00:39,108
གསལ་སྟོང་ནམ་མཁའ་དང་ཕྱི་ནམ་མཁའ་ལ་དཔེ་མཚུངས་པ།

9
00:00:40,246 --> 00:00:43,455
ཕྱི་ནམ་མཁའ་དང་ནང་སེམས་ཉིད་གཉིས་པོ་ངོ་གཅིག་པར་འདྲ་བོ་ད་ཆགས་ཡོང་གི་ཡོད་རེད།

10
00:00:44,235 --> 00:00:46,612
དེའི་སྐབས་ལ་དེ་ནས་སེམས་དེ་དཔེ་རྒྱ་ཆེན་པོ་ཟེར།

11
00:00:46,748 --> 00:00:47,988
ཨེ། ཆགས་ཡོང་གི་རེད།

12
00:00:51,502 --> 00:00:54,575
རྣམ་རྟོག་ཐམས་ཅད་དང་བྲལ་བའི་དེ་ནས་སེམས་ནམ་མཁའ་ལྟ་བུ་ཟེར།

13
00:00:55,237 --> 00:00:57,716
རྣམ་རྟོག་ཚོགས་ཀྱིས་སེམས་ཀྱི་རང་བཞིན་མཐོང་ཟེར།

14
00:02:25,797 --> 00:02:26,816
དེ་ནས་ད་ལྟ།

15
00:02:27,971 --> 00:02:30,959
རྣམ་རྟོག་ཚོགས་འགག་སེམས་ཀྱི་རང་བཞིན་མཐོང་བརྫས།

16
00:02:31,298 --> 00:02:36,544
ཆོས་གྲོགས་རྣམ་པ་ད་ལྟ་མལ་གསོ་བའི་སྐབས་ནས་ད་ཐམས་ཅད་བལྟ་དགོས་རེད། རང་ཡང་དང་ཡང་དུ་ལྟ་སྤྱོད་ལམ་ཐམས་ཅད་ནས་བལྟ། 

17
00:02:37,139 --> 00:02:38,344
ལྟ་བའི་སྐབས་ནས་དེ་ནས།

18
00:02:39,787 --> 00:02:46,629
སེམས་ཀྱིས་སེམས་ལ་ཚུར་བལྟས་ན། རྣམ་རྟོག་རྒྱུན་ཆད་མེད་པ་མང་དུ་སོང་བ་ནང་བཞིན་མཐོང་གི་ཡོད་རེད། མཚམས་མཚམས་ལ་མཚམས་ཆད་ཀྱི་ཡོད་རེད། མཚམས་ཆད་པའི་སྐབས་ནས།

19
00:02:47,563 --> 00:02:50,959
ག་རེ་ཡོང་གི་རེད། སེམས་དེ་ཚོར་བ་ཞིག་ཡོང་གི་ཡོད་རེད། ཚོར་བ་གང་རེད་བརྫས་ན།

20
00:02:51,825 --> 00:02:53,760
རྣམ་རྟོག་དངོས་གནས་མཆེད་ཡོང་ན། སེམས་ནང་ནས།

21
00:02:55,509 --> 00:02:57,495
སེམས་སྐྱིད་པོ་འདྲ་བོ་ཆགས་ཡོང་གི་ཡོད་རེད།

22
00:02:59,414 --> 00:03:01,536
དེའི་སྐབས་ནས་ག་རེ་ཚོར་བ་རེད་ཟེར་ན་ཨོ།

23
00:03:02,300 --> 00:03:05,475
རྣམ་རྟོག་ཐམས་ཅད་དང་བྲལ་བའི་སེམས་དེ་ཡིན་པ་ད་ཧ་གོ་གི་ཡོད་རེད།

24
00:03:05,560 --> 00:03:07,954
ཨེ། རྣམ་རྟོག་བྲལ་བའི་བདེ་བ་རེད་ཟེར།

25
00:03:09,567 --> 00:03:11,044
ཁོ་དོན་དམ་པའི་བདེ་བ་ཟེར།

26
00:03:12,911 --> 00:03:21,502
དེ་ནས་སྡུག་བསྔལ་དེ་རྣམ་རྟོག་གིས་བཟོ་གི་ཡོད་རེད། དེ་ནས་རྣམ་རྟོག་ཐམས་ཅད་མང་དུ་སོང་ན་རྣམ་རྟོག་མ་འཛིན་ན། དེ་ནས་མཚམས་མཚམས་ལ་ཆད་ཡོང་གི་ཡོད་རེད། དེ་ནས་དེ་ངོས་འཛིན་ནས་དེ་ནས་ད་ད་ལྟ།

27
00:03:22,741 --> 00:03:24,354
བསྒྲུབ་བྱ་གཏན་ལ་ཕབ་ལ་གསོལ་བ་བཏབ།

28
00:03:24,541 --> 00:03:26,290
ཨེ་ནས་སངས་རྒྱས་ལ་གསོལ་བ་བཏབ་ནས་དེ་ནས།

29
00:03:26,799 --> 00:03:27,920
སོ་སོ་ཡི་སེམས་ལ་ཡ།

30
00:03:28,276 --> 00:03:29,821
ཨེ། ཡང་དང་ཡང་དུ་ལྟ།

31
00:03:30,806 --> 00:03:31,842
གལ་ཆེན་པོ་ཡོད་རེད་ཟེར།

