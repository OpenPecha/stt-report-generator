དེ་ནས་ཆོས་ཀྱི་དབྱིངས་ཀྱི་བུ་རམ་ཞེས་པ་ཡང་ད་ལྟ། ཨ།

114
00:37:14,202 --> 00:37:22,962
ཨ། ད་མཁས་པ་རྣམ་པས་གསུང་ལས་མང་པོ་ཡོད་རེད། ཡིན་ན་ཡང་དེ། ཆོས་སྐུ་དང་ལོངས་སྐུ་ཟུང་འབྲེལ་ཁ་ཤས་ཀྱིས། བདེ་བ་ཅན་ཞེས་ལམ་གྱི་ཞིང་ཁམས་ཐམས་ཅད་ཡོད་དང་མེད་ཐེ་ཚོམ་ཡོད་རེད།

115
00:37:23,336 --> 00:37:33,200
ཆོས་སྐུ་དང་ལོངས་སྐུ་ཟུང་འབྲེལ་བརྫས་ནས། ལོངས་སྐུ་རྒྱ། འདི་ལོངས་སྐུ་ངེས་པ་ལྔ་ལྡན་བརྫས།  ཨེ། ཆོས་སྐུ་དང་ལོངས་སྐུ་དབྱེར་མེད་པ་བརྫས་ན། ཨ། གསལ་བའི་རང་བཞིན་དེ་ལོངས་སྐུ།

116
00:37:33,624 --> 00:37:41,825
ངོ་བོ་སྟོང་པའི་རང་བཞིན་དེ་ཆོས་སྐུ་བརྫས། དེ་ལྟ་བུ་སངས་རྒྱས་ཀྱི་སྐུ་དང་ཞིང་ཁམས་གྲངས་མེད་པ་དེ་ཆོས་ཀྱི་དབྱིངས་ཀྱི་ཕོ་བྲང་ལ་ཡོད་རེད། དེ་ནས་ང་ཚོས་ད་ལྟ་ལྷག་ཏུ་ཕེབས་ཤོག་འདི་དེ་བ་

117
00:37:41,994 --> 00:37:51,799
ཁོང་རྣམ་པ་དེ་འདྲས་ཕེབས་ཡོང་གི་ཡོད་རེད། ཆོས་ཀྱི་དབྱིངས་དེ་ཕོ་བྲང་དེ་ལ། དེ་ནས་དེ་སོ་སོས་གནས་ལུགས་རྟོགས་ན་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་དེ། རྣམ་ཤེས་ཡེ་ཤེས་ལ་འགྱུར་ན། དེ་ནས་ཆོས་ཀྱི་ཕོ། ཆོས་ཀྱི་དབྱིངས་ཀྱི་ཕོ་བྲང་

118
00:37:51,799 --> 00:38:01,604
མཐོང་གི་ཡོད་རེད། དེ་ནས་དེ་ན། ཨེ། འགྲོ་དགོས་ན་དེ་ནས་མངོན་པར་རྫོགས་བརྫས་ན། དེ་ད་ལྟ་ང་ཚོ། ཨེ། དང་པོ་སྐྱབས་སུ་འགྲོ་བ་ནས་དེ་ནས་བྱང་ཆུབ་ཀྱི་སེམས་སྐྱེད་དེ་ནས་

119
00:38:01,791 --> 00:38:03,930
དེ་ནས་རང་གཞིན་བྱང་ཆུབ་ལམ་གྱི་རིམ་པ་ཟེར།

120
00:38:04,320 --> 00:38:16,697
དེ་ཡང་ས་ལམ་གྱི་ཡོན་ཏན་ཐམས་ཅད་མངོན་པར་རྫོགས་ནས་དེ་འདི། ཀུན་ཏུ་བཟང་པོ་འདི། ཆོས་དབྱིངས་ཕོ་བྲང་ལ་སླེབས་ཐུབ་ཀྱི་ཡོད་རེད། དེ་བསམ་ནས་སྨོན་ལམ་རྒྱབ་པ་ཡིན་ཟེར། ཨ། མངོན་པར་རྫོགས་ནས་ཚང་རྒྱ་ཤོག་གསུངས་

121
00:40:23,675 --> 00:40:31,146
ཀུན་གྱི་གཞི་ནི་འདུས་མ་བྱས་གསུངས། ད་ཀུན་གཞི་ཞེས་པ་གང་རེད་ཟེར་ན། སངས་རྒྱས་སེམས་ཅན་གཉིས་ཀྱི་གཞི་དེ། འདུས་མ་བྱས་པ་རེད་ཟེ།

122
00:40:31,400 --> 00:40:39,889
འཁོར་འདས་ཀྱི་ཆོས་ཐམས་ཅད་འདུས་བྱས་ཡིན་པ། འདུས་བྱས་ཡིན་ན་མི་རྟག་པ་ཨེ་རེད། ཨེ། ཡིན་ནའང་སེམས་བདེ་གཤེགས་སྙིང་པོ་དེ་ཡང་འདུས་མ་བྱས་པ་རེད་ཟེ།

123
00:40:40,348 --> 00:40:46,171
ཨེ། འདུས་མ་བྱས་པ་ཡང་གང་ཡིན་ན། རང་བྱུང་ཀློང་ཡངས་བརྗོད་དུ་མེད་བརྫས། རང་བྱུང་ཀློང་ཡངས་ཞེས་པ་དེ།

124
00:40:46,392 --> 00:40:47,682
རང་བྱུང་རེད་བརྫས།

125
00:40:47,988 --> 00:40:49,227
ནང་སེམས།

126
00:40:49,329 --> 00:40:51,757
ནང་གི་སེམས་ཕྱི་ཡོད་པའི་ནམ་མཁའ་རེད་ཟེར།

127
00:40:52,130 --> 00:41:01,740
ནམ་མཁའ་ལ་ཡོད་མེད། རྟག་ཆད་མཐའ་མེད་བསྡད་པ། ཨ། བརྟག་དཔྱད་གཏོང་ཐུབ་ཀྱི་ཡོད་རེད། ནམ་མཁའ་མཐོང་ཞེས་བཤད་ཐུབ་ཀྱི་ཡོད་རེད། ནམ་མཁའ་འདི་ར་ཡོད་དང་མེད་ཟེར། ཕྱག་རྒྱའི་ངོ་སྤྲོད་ནང་ནས།

128
00:41:02,147 --> 00:41:06,528
དེ་རྫོ་ལས། ཚུར་སེམས་ལ་དེ་ལ་དེ་ནས། སྨྲ་བསམ་བརྗོད་མེད། མིང་བཏགས་ཡ་མེད་པ།

129
00:41:06,850 --> 00:41:13,845
དེ་ནས་བལྟ་ཤེས་ན། རང་གིས་མཐོང་བའི་དེ་ནས། དེ་ནས་གསལ་སྟོང་ནམ་མཁའ་ལྟ་བུ། ཨེ། གསལ་བའི་རང་བཞིན་སྟོང་པ། སྟོང་པའི་རང་བཞིན་

130
00:41:13,930 --> 00:41:16,375
གསལ་བ་གསལ་སྟོང་དབྱེར་མེད་པ་བརྫས།

131
00:41:16,867 --> 00:41:17,937
ཨེ། དེ་ནས་འདི་ལྟ་བུ་

132
00:41:18,582 --> 00:41:19,957
བརྗོད་དུ་མེད་པ་གསུང་ཡོད་རེད།

133
00:41:24,439 --> 00:41:28,616
འཁོར་འདས་གཉིས་ཀ་མིང་མེད་དོ་ཟེར། ཨོ། སེམས་བདེར་གཤེགས་སྙིང་པོ་དེ་ལ་མིང་བཏགས་ཡོད་ན།

134
00:41:28,938 --> 00:41:32,317
འཁོར་བ་མིང་བཏགས་རྒྱུ་ཡོད་མ་རེད། སེམས་ཁོ་རང་གཞི་ལ་སངས་རྒྱས་རེད་ཟེར།

135
00:41:32,826 --> 00:41:35,899
ཨེ། རང་བཞིན་གྱིས་དེ་ནས་བཏགས་ཐོབ་བྲལ་བའི་སེམས་བྱང་བས་གསུངས།

136
00:41:39,074 --> 00:41:45,000
སངས་རྒྱས་ཟེར་ལས་མིང་བཏགས་ཡ་ཡོད་མ་རེད། ཡང་ཨེ། དེ་མ་མཐོང་བའི་སེམས་ཅན་གནས་སྐབས་འཁོར་བ་ལ་འཁྱམ་ཡོང་གི་ཡོད་རེད།

137
00:41:45,203 --> 00:41:50,008
ཨེ། ཀུན་གཞི་དེ་ལ་མིང་གཅིག་ཀྱང་བཏགས་ཡ་ཡོད་མ་རེད། སངས་རྒྱས་སེམས་ཅན་གཉིས་ཀ་མིང་མེད་དོ་གསུངས།

138
00:41:51,095 --> 00:41:52,096
ཀུན་གཞི་ཁོང་ལ།

