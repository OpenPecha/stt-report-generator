330
01:33:49,261 --> 01:33:53,709
སངས་རྒྱས་བཅོམ་ལྡན་འདས་ཀྱིས་ད་ལྟ་བག་ཡོད་ཡོན་ཏན་ཀུན་གྱི་གཞི་ཡིན་ཟེར།

331
01:33:53,964 --> 01:33:58,106
གང་དེས་སྟོང་ཉིད་ཤེས་དེ་བག་ཡོད་ཡིན། སྟོང་པ་ཉིད་ཧ་གོ་ནས་སྟོང་པ་ཉིད་ཤེས་ན།

332
01:33:58,718 --> 01:34:02,877
བག་ཡོད་པ་དེ་སྟོང་པ་རེད་ཟེར། བག་ཅེས་པ་རང་དེ་སེམས་ཀྱི་སར་བསྲུངས་ནས།

333
01:34:03,556 --> 01:34:05,356
རང་གི་སེམས་མཉམ་དུ་འདུལ་ཟེར།

334
01:34:09,448 --> 01:34:10,500
དེ་ནས་སེམས་ནི།

335
01:34:11,757 --> 01:34:13,930
དགེ་མི་དགེའི་རྟོག་པ་དེ་ཚོ་ཧ་གོ་ནས།

336
01:34:14,473 --> 01:34:17,071
དེ་ནས་སྟོང་ཉིད་ཟེར་ན་དཔེར་ན་བག་ཡོད་པ་ཡིན་ན།

337
01:34:17,359 --> 01:34:18,972
འདི་ཞེ་སྡང་ལངས་ཧ་གོ་སོང་།

338
01:34:20,993 --> 01:34:27,258
འཁོར་བ་ཐོག་མ་མེད་པ་ནས་དགྲ་ཞེ་སྡང་དེ། ད་དེ་སེམས་ཅན་ཐམས་ཅན་ཁོས་བཟོས་ཡོད་རེད། ཁམས་གསུམ་སེམས་ཅན་སྡུག་བསྔལ་ཁོས་བཟོ་གི་ཡོད་རེད་ཟེར།

339
01:34:27,818 --> 01:34:29,957
སྔར་ནས་ད་ལྟ་ཡང་སྡུག་བསྔལ་དེ་ཁོས་བཟོས་ཡོད་རེད།

340
01:34:30,178 --> 01:34:31,672
མ་འོངས་པ་ལ་སྡུག་བསྔལ་ཁོས་བཟོ་གི་འདུག

341
01:34:33,064 --> 01:34:36,324
དགྲ་ལ་ཞེ་སྡང་ཁོ་མ་གཏོགས་མི་འདུག་བསམས་ནས་དེ།

342
01:34:36,867 --> 01:34:40,415
ལག་ལེན་སོ་བདུན་ནང་ལ་གསུངས་པ་རེད། རང་གི་ཞེ་སྡང་དགྲ་བོ་མ་ཐུལ་ན་ཟེར།

343
01:34:41,179 --> 01:34:44,949
ད་འཛམ་བུ་གླིང་ལ་དགྲ་དེ་ཞེ་སྡང་རེད་བསམ་ཧ་གོ་ན། དེ་ནས།

344
01:34:45,747 --> 01:34:50,857
སྟོང་པ་ཉིད་དེ་ཧ་གོ་་ནས་ཞེ་སྡང་དེ་ཤེས་རབ་ཀྱི་ཧ་གོ་ན། ཞེ་སྡང་ལངས་ན་ཁོ། ཞེ་སྡང་ཁོ་མེད་པ་འདྲ་བོ་རེད།

345
01:34:51,706 --> 01:35:02,113
ཞེ་སྡང་དེ་ཤིང་འདྲ་བོ་རེད། ཤེས་རབ་དེ་མེ་འདྲ་བོ་རེད། དེ་ནས་མེད་པ་འདྲ་བོ་རེད། ཨོ། ཞེ་སྡང་དེ་སྟོད་པ་ཉིད་བཅོས་སོ།། ཨོ་སྟོང་ཉིད་ཤེས་དེ་བག་ཡོད་པ་རེད། བག་ཡོད་དེ་རྩ་ཆེན་པོ་རེད་ཟེར། ཧ་གོ་ན།

346
01:37:17,801 --> 01:37:21,027
ད་རྫོགས་ཆེན་ཉམས་ལེན་བྱེད་མཁན་མང་པོ་ཡོད་རེད། རྫོགས་ཆེན་ཉམས་ལེན་བྱས་ན།

347
01:37:21,485 --> 01:37:24,524
རིག་པ་དེ་རང་དབང་ཐོབ་པར་བྱིན་གྱིས་རློབས། གསོལ་བ་དེ་གདབ་དགོས་རེད།

348
01:37:24,694 --> 01:37:26,188
རིག་པ་དེ་རང་དབང་ཐོབ་དུས།

349
01:37:26,443 --> 01:37:31,604
ང་རིག་པ་ག་དུས་ཡིན་ཡང་ཐུག་ཐུབ་ཀྱི་རེད་བསམ། དྲན་པ་དང་བྲལ་ལེ་རེད། ད་རིག་པ་དེ་རྩ་ཆེན་པོ་ཡིན་བསམས་ནས།

350
01:37:32,266 --> 01:37:38,174
འོ་ན་རིག་པ་དེ་ཁྱོད་ཞེ་སྡང་ལངས་ན། ཞེ་སྡང་ལངས་ན་དེ་ཞེ་སྡང་ཡིན་པ་ཧ་གོ་གི་ཡོད། ཧ་གོ་གི་ཡོད་རེད་འོ་དེ་ད་རིག་པ་དེ་རེད།

351
01:37:38,735 --> 01:37:40,398
དེའི་རང་དབང་ཐམས་ཅད་ཞེ་སྡང་དེ།

352
01:37:40,925 --> 01:37:43,064
ཞེ་སྡང་དེ་ཕར་གནོན་ཐུབ་དགོས་རེད། དེ་གནོན་ཐུབ་ན།

353
01:37:43,404 --> 01:37:44,966
དེ་ནས་ཞེ་སྡང་ལ་སྐྱོན་མ་ཤེས་ན།

354
01:37:45,526 --> 01:37:48,633
ངའོ་སྙམ་པ་དེ་ཡིས་དེ་ནས་ཞེ་སྡང་གི་རྒྱབ་རྩ་བྱེད་ཀྱི་ཡོད་རེད།

355
01:37:48,955 --> 01:37:50,823
དཔེར་ན། ངེད་གཉིས་སྐྱོན་ཆེན་པོ་རེད།

356
01:37:51,400 --> 01:37:54,592
ཁོ་་ཡིས་ང་ལ་རྟག་པར་བསམས་ཚུལ་བཏོན་དེ་ནས།

357
01:37:55,067 --> 01:37:56,952
ང་དེས་ཞེ་སྡང་ལ་གྲོགས་བྱེད་ཀྱི་ཡོད་རེད།

358
01:37:57,631 --> 01:38:02,741
དེ་ནས་ཤེས་རབ་དེ་ཡིས་རེ་རེད། ཨོ། དགྲ་ཞེ་སྡང་ཁོའི་ཞེ་སྡང་ཁོ་ཡི་སྐྱོན་ཧ་གོ་ཚར་རེད།

359
01:38:03,658 --> 01:38:07,461
ཁྱེད་རང་ཁོག་ག་རེ་བཏང་ན་བཏང་ང་ག་རེ་ལབ་ལབ། ཞེ་སྡང་ཁྱེད་རང་མི་དགོས་ཟེར།

360
01:38:07,937 --> 01:38:10,942
དེ་ནས་དེ་རེད། རིག་པ་ཚང་མ་ལ་ཡོད་རེད་ད་ལྟ། འོ་ལེ།

361
01:38:11,536 --> 01:38:13,845
དེ་ཞེ་སྡང་ཡིན་པ་ཧ་གོ་རེད། དེ་རིག་པ་རེད་ཟེར།

