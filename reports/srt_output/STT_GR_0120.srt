མ་རིག་པ་དེ་ད་ལྟ་ངོས་འཛིན་ན་བདག་རེད་ཟེར། དེ་ལ་དེ་བདེ་བར་གཤེགས་པ་ལ་བདེ་བ་དང་བདེ་བའི་རྒྱུ་ག་རེད། ད་བྱམས་པ་དང་སྙིང་རྗེ་རེད། བྱམས་པ་དང་འབྲེལ་བའི་སྙིང་རྗེ་རེད་ཟེར།

111
00:39:47,320 --> 00:39:54,078
དྲིན་དྲན་པ། དྲིན་བཟོ་བ། དྲིན་ཅན་ཨ་མ་ནས་མགོ་བཟུང་སྟེ་དེ་ནས་ད་ལྟ་བྱམས་བརྩེ་དེ། ད་ཕྲ་བའི་ཕྲ་བ་སེམས་

112
00:39:54,078 --> 00:40:00,837
རེད་བ། དེ་ནས་ངོས་བཟུང་ནས། དེ་ཆེ་རུ་གཏོང་བ། མང་རུ་གཏོང་བ། དེ་དེ་རེད། བདེ་བ་དང་བདེ་བའི་རྒྱུ་དང་ལྡན་པར་འགྱུར་ཅིག་ཟེར་སྨོན་ལམ་དེ་རྒྱབ་ཀྱི་ཡོད་རེད་ཟེར།

113
00:40:01,174 --> 00:40:04,617
སྡུག་བསྔལ་དང་ཟེར། ཁྱོད་ད་ལྟ་སྡུག་བསྔལ་ག་རེ་འདུག

114
00:40:05,207 --> 00:40:10,523
དེ་ལ་བསམ་བློ་གཏང་། དེའི་རྒྱུ་དེ་ག་བར་འདུག ད་སེམས་ཀྱི་ནང་ལ་ཚུར་ཡོད། རང་གི་སེམས་ནང་ལ་ཡོད་རེད་ཟེར། ཕྱི་ནས་ཡོད་མ་རེད་ཟེར།

115
00:40:11,485 --> 00:40:12,582
ཨོ་མེ་ཏོག་གིས་

116
00:40:13,307 --> 00:40:18,235
ཁ་དོག་ཚོན་རྣམ་པ་སྣ་ཚོགས་མེ་ཏོག་ས་བོན་དེ་ལ་ཡོད་རེད། ད་ལྟ་ས་བོན་དེ་ལ་གང་ཡང་ཡོད་མ་རེད་ཟེར།

117
00:40:18,623 --> 00:40:25,896
གཅིག་པ་གཅིག་རྐྱང་དེ་ནས་རང་གི་སེམས་ནང་ལ་ཚུར་བརྟག་དཔྱད་བཏང་ན། ཁྱོད་སྡུག་བསྔལ་གྱི་རྒྱུ་དེ་གང་རེད། ད་བདག་འཛིན་རེད། ངའོ་སྙམ་པ་འདི་ཡོད་རེད་ཟེར།

118
00:40:27,550 --> 00:40:36,375
དེས་ད་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་རྒྱུ་དང་བྲལ་བ། དེ་ལས་བྱུང་བའི་ཉོན་མོངས་ དུག་གསུམ། དེ་ལས་བྱུང་བའི་དུག་ལྔ། ཨ། ཞེ་སྡང་དང་ཕྲག་དོག་ལ། ཨ། སེར་སྣ་དང་།

119
00:40:36,713 --> 00:40:40,088
ཕྲག་དོག་ལ་སོགས་པ་དེ། ད་དེ་ལྟ་བུ། དེ་ནས་ཉོན་མོངས་དྲུག

120
00:40:40,527 --> 00:40:50,527
དེ་ལས་ཀྱང་ཉོན་མོངས་པའི་ཕུང་པོ་བརྒྱད་ཁྲི་བཞི་སྟོང་གསུངས་རེད། དེ་ད་ལྟ་ཀུན་ཏུ་བཟང་པོའི་སྨོན་ལམ་ནང་ལ་གསུངས་པ་ནང་བཞིན། དེའི་ལས་དེ་སྨིན་ཡོང་ན་དེ་ནས་ད་དངོས་གནས་དེ་ནས་མེ་ཏོག་ས་བོན་ས་ནང་ལ་སོང་།

121
00:40:50,527 --> 00:41:00,527
དེ་ནས་མེ་ཏོག་རྣམ་པ་སྣ་ཚོགས་ཡོད་རེད། དཔེ་དེ་ལྟ་བུ་དེ་ནས་རིགས་དྲུག་གི་སེམས་ཅན་དེ་ཕྲ་རགས་མང་པོ་ད་དེ་ལ། དེ་ལ་རྒྱུ་འབྲས་སྐད་ཅིག་བསམ་པའི་རང་གཟུགས་ཡིན་ཟེར། ལས་རྒྱུ་འབྲས་ལ་བསམ་བློ་བཏང་།

122
00:41:00,527 --> 00:41:02,886
ན་ད་ཕྱི་རོལ་འགྲོ་བ་རིགས་དྲུག་ལ་བསམ་བློ་བཏང་ན།

123
00:41:03,139 --> 00:41:06,244
དེ་དེའི་རྒྱུ་རྒྱུ་དེ་གང་རེད། ད་སེམས་ཀྱི་ནང་ནས་ཚུར་སྙོབ་དགོས་ཀྱི་རེད་ཟེར།

124
00:46:53,262 --> 00:47:03,262
དེ་ནས་དེ་བས་ད་ལྟ་བསམ་བློ་བཏང་དུས་དེ་ནས་བདེ་བའི་རྒྱུ་དེ་དྲན་པར་བྱེད་པ་ལ་འཇིག་རྟེན་གྱི་ཁམས་འདི་ན་ཡང་། ཨེ་མི་ཚང་ཆུང་ཆུང་ཞིག་གཅིག་གི་ནང་ན་འཚོ་བ་བྱས།

125
00:47:03,262 --> 00:47:13,262
ལུས་ལོངས་སྤྱོད། ཕ་མ་སྤུན་གསུམ་མཐུན་པོ། ཨེ། དེ་ནས་དེ་མི་ཚེ་གང་པོ་དེ་ལྟ་བུ་ཆགས་ན་དེ་ནས། ཨེ། མི་ཚེ་འདིའི་བདེ་བ་དེ་རེད། དེ་རྒྱུ་གང་རེད་དེ་ནས།

126
00:47:13,262 --> 00:47:23,262
ཨེ། དེ་ནས་སྤྱིར་བཏང་། ཨེ། སྦྱིན་པ་ལ། ཨེ། སྦྱིན་པ་ལ་བརྟེན་ནས་ལོངས་སྤྱོད་ཚུལ་ཁྲིམས་ལ་སྲུང་བས་མི་ལུས། བཟོད་པ་ལ་དེ་ནས་གྲོགས་བཟང་པོ། གདོང་རྫིག་པོ། ཚེ་རིང་བ་ལ་སོགས་པ།

127
00:47:23,262 --> 00:47:33,262
ཐུགས་ཀྱི་ཡོན་ཏན་གསུམ་དེ་སྦྱིན་པ་ཚུལ་ཁྲིམས་བཟོད་པ་གསུམ་ལས་བྱུང་ཡོད་རེད། དེ་ལ་བརྟེན་ནས་དེ་ནས་ད་ལྟ་སྦྱིན་པ་ཚུལ་ཁྲིམས་བཟོད་པ་གསུམ་དེ་བྱམས་བརྩེ་ལས་བྱུང་རེད། དེ་ལྟ་བུ་བསམ་བློ་བཏང་ན་ཨོ།

128
00:47:33,262 --> 00:47:38,504
བདེ་བའི་རྒྱུ་དངོས་གནས་དེ་བྱམས་བརྩེ་གཅིག་པུ་རེད་བཞག་ཟེར། བྱམས་པ་དང་སྙིང་རྗེ་མི་ཚེ་འདིར་བདེ་བ། ཨེ།

129
00:47:39,179 --> 00:47:45,709
དེ་ནས་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དེ་ད་འཛམ་བུ་གླིང་ལ་སྡུག་བསྔལ་ག་རེ་འདུག་ཡང་དེ་བརྟེན་དེ་ནས་དེ་གོ་ལྡོག་ནས། ཨོ།

130
00:47:46,114 --> 00:47:56,114
ད་དེ་ནས་ཁ་ཤས་ལ་དེ་ནས་སྡུག་བསྔལ་ཆེན་པོ་ཡོད་རེད། བཀྲེས་སྒོམ་སོགས་ཡི་དྭགས་ཀྱི་སྐྱོན་ལྟ་བུ་ཡོད་རེད། དེ་ཐམས་ཅད་སེར་སྣ་ལ་སོགས་པ་དེ་སྐྱོན་ཤ་སྟག་བསམ་བློ་བཏང་ནས་དེ་ནས།

131
00:47:56,114 --> 00:48:06,114
དེའི་སྐོའི་ལ་བསམ་བློ་ཡག་པོ་བཏང་ནས། ད་སྡུག་བསྔལ་གྱི་རྒྱུ་དུ་ངོས་འཛིན་ཐུབ་ཀྱི་ཡོད་རེད། ཡིད་གྱི་སྡུག་བསྔལ་ཚང་མའི་རྒྱུ་དེ་ག་བར་འདུག གཞན་གྱི་སྡུག་བསྔལ་མཐོང་བའི་སྐབས་སུ། དེ་ནས་རང་མཐོང་རང་།

132
00:48:06,114 --> 00:48:15,325
རང་ངོས་ནས་ཉོན་མོངས་པ་དས་ངོས་འཛིན་དགོས་རེད། ཨོ། རང་གི་ཉོན་མོངས་པ་ད་ཕྲ་ཞིང་ཕྲ་བ་འདི་རེད་བསམས་ནས། འདི་ཡིས་ལས་བསགས་པ་དེའི་འབྲས་བུ་འདི་རེད་ཟེར། དེ་ནས་མི་ལ་དེ་ཨེ།

133
00:48:17,130 --> 00:48:22,918
རྒྱུ་མཚན་བཤད་ཐུབ་ཀྱི་ཡོད་རེད། སོ་སོ་རང་གིས་བཤད་ཐུབ་ཀྱི་ཡོད་རེད། སོ་སོ་རང་གི་ཉམས་མྱོང་ཡིད་ཆེས་དང་ལྡན་པའི་སྒོ་ནས། ཨོ་མི་དེ།

134
00:48:22,918 --> 00:48:28,706
སྡུག་བསྔལ་གྱི་རྒྱུ་དེ་རེད་ཟེར། ཨོ་དེ་ལ་དེ་ག་རེ་བྱེད་དགོས་རེད། ད་ད་ལྟ་ད་མི་ཚེ་འདི་ལ་ཡིན་ནའང་དེ་དྭང་ལེན་བྱེད་དགོས་རེད་ཟེར།

135
00:48:28,875 --> 00:48:36,865
ཨོ་དེ་ལ་སྡུག་བསྔལ་གྱི་རྒྱུ་དེ་སྤང་དགོས་རེད། ཉོན་མོངས་པ་སྤང་དགོས་རེད་ཟེར་སྤང་བློ་དེ་ནས་ཡོང་། ཨོ། བདེ་བའི་རྒྱུ་དེ་སྒྲུབ་བློ་དེ་ནས་སྦྱིན་པ་ཚུལ་ཁྲིམས་བཟོད་པ།

